"use client";

import { useState, useEffect } from "react";
import Topbar from "../components/Topbar";
import MentorManager from "../components/MentorManager";
import CapitalManager from "../components/CapitalManager";

// NUEVOS COMPONENTES RUCUTÚ IMPORTADOS
import DiversificationChart from "../components/DiversificationChart";
import PortfolioHealth from "../components/PortfolioHealth";
import BunkerManifesto from "../components/BunkerManifesto";

export default function ProfilePage() {
  const [displayUnit, setDisplayUnit] = useState("$");
  
  // Memoria institucional para la cuenta
  const [selectedAccount, setSelectedAccount] = useState(() => {
    if (typeof window !== "undefined") return localStorage.getItem("bunker_account") || "ALL";
    return "ALL";
  });

  useEffect(() => {
    if (typeof window !== "undefined") localStorage.setItem("bunker_account", selectedAccount);
  }, [selectedAccount]);

  return (
    <div className="bg-slate-50 dark:bg-slate-950 text-slate-700 dark:text-slate-300 min-h-screen font-sans pb-10 pl-[250px] relative transition-colors duration-300">
      
      {/* 1. EL TOPBAR */}
      <Topbar 
        title="Profile & Settings" 
        icon="person" 
        displayUnit={displayUnit} 
        setDisplayUnit={setDisplayUnit} 
        selectedAccount={selectedAccount} 
        setSelectedAccount={setSelectedAccount} 
        onAddTradeClick={() => console.log("Abre modal aquí si lo necesitas")} 
      />

      {/* 2. CONTENIDO PRINCIPAL (con pt-24 para respetar el Topbar) */}
      <main className="pt-24 px-6 max-w-[1400px] mx-auto space-y-6">
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* COLUMNA IZQUIERDA: Identidad, Gráficos y Manifiesto */}
          <div className="space-y-6">
            
            <div className="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm p-6 relative transition-colors duration-300">
              <h2 className="text-[11px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-4">Datos del Operador</h2>
              <div className="flex items-center gap-4 mb-6">
                <div className="w-14 h-14 bg-gradient-to-br from-indigo-500 to-pink-500 rounded-full flex items-center justify-center text-white font-black text-xl shadow-md">
                  A
                </div>
                <div>
                  <h3 className="font-bold text-slate-800 dark:text-slate-100 text-lg">Acane</h3>
                  <div className="text-xs font-semibold text-slate-500 dark:text-slate-400">Juan Diaz</div>
                </div>
              </div>
              <label className="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase mb-1 block">Identificador Comercial</label>
              <input type="text" defaultValue="Acane Trading Corp." className="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-sm font-bold text-slate-600 dark:text-slate-300 outline-none" readOnly />
            </div>

            {/* AQUI ESTÁN TUS 3 NUEVOS MÓDULOS APILADOS */}
            <DiversificationChart />
            <PortfolioHealth />
            <BunkerManifesto />

          </div>

          {/* COLUMNA DERECHA: Consolidado y Mentores (Toma 2 espacios) */}
          <div className="lg:col-span-2 space-y-6">
            <CapitalManager />
            <MentorManager />
          </div>

        </div>
      </main>
    </div>
  );
}